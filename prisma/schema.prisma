// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReportCategory {
  ROAD_ISSUE
  GRAFFITI
  ILLEGAL_DUMPING
  STREET_LIGHT_ISSUE
  OTHER
}

enum ApplicationType {
  EVENTS
  PYROTECHNICS
  COMMERCIAL
  RESIDENCY
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  DELETED
}

enum DocumentType {
  IDENTIFICATION
  PROOF_OF_ADDRESS
  INSURANCE_POLICY
  LAND_USE_CERTIFICATE
  OTHER
}

enum PersonType {
  INDIVIDUAL
  LEGAL_ENTITY
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  name      String?
  lastname  String?

  role       Role    @default(USER)

  isActive   Boolean @default(true)
  verified   Boolean @default(false)
  verifiedAt DateTime?
  verificationToken String? @unique

  resetToken           String? @unique
  resetPasswordExpires DateTime?

  isBanned   Boolean @default(false)
  bannedAt   DateTime?
  banReason  String?

  canReport  Boolean @default(false)
  isDeleted  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports              Report[]
  reportStatusChanges  ReportStatusHistory[]
  applications Application[] @relation("ApplicationOwner")
  applicationStatusChanges ApplicationHistory[] @relation("ApplicationStatusChange")
}

model Report {
  id          String @id @default(uuid())
  title       String
  description String
  category    ReportCategory @default(OTHER)

  latitude  Float
  longitude Float

  status     ReportStatus @default(PENDING)
  isVisible  Boolean      @default(true)
  isDeleted  Boolean      @default(false)

  userId  String
  user    User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history ReportStatusHistory[]

  @@index([latitude, longitude])
  @@index([status])
  @@index([category])
}

model ReportStatusHistory {
  id            String @id @default(uuid())

  reportId      String
  report        Report @relation(fields: [reportId], references: [id])

  oldStatus     ReportStatus
  newStatus     ReportStatus

  changedById   String
  changedBy     User @relation(fields: [changedById], references: [id])

  changedAt     DateTime @default(now())
}

model Application {
  id               String                @id @default(uuid())
  folio            String             @unique
  applicationType  ApplicationType
  status           ApplicationStatus  @default(SUBMITTED)

  requestDate      DateTime           @default(now())
  resolutionDate   DateTime?

  rejectionReason  String?
  observations     String?

  personType       PersonType
  userId           String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Relations
  user             User               @relation("ApplicationOwner",fields:      [userId], references: [id])

  data             ApplicationData?
  documents        Document[]
  history          ApplicationHistory[]

  @@index([applicationType])
  @@index([status])
}

model ApplicationData {
  id            String       @id @default(uuid())
  applicationId String       @unique
  data          Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Document {
  id            String      @id @default(uuid())
  applicationId String

  documentType  DocumentType
  fileName      String
  filePath      String
  mimeType      String
  fileSize      Int

  validated     Boolean  @default(false)

  uploadedAt    DateTime @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model ApplicationHistory {
  id             String                 @id @default(uuid())
  applicationId  String
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus
  action         String
  createdAt      DateTime            @default(now())

  changedById String?
  changedBy   User? @relation("ApplicationStatusChange",fields: [changedById], references: [id])

  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}